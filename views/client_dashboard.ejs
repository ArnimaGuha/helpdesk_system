<!DOCTYPE html>
<html>
<head>
    <title>Client Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="container py-5" style="max-width: 1100px;">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bold text-dark">Client Dashboard</h2>
            <p class="text-muted mb-0">Welcome back, <%= user.name %></p>
        </div>
        <div class="d-flex gap-2">
            <a href="/client/raise" class="btn btn-primary">Raise New Issue</a>
            <a href="/logout" class="btn btn-outline-danger">Logout</a>
        </div>
    </div>
    
    <h4 class="mb-3 fw-semibold text-dark" style="font-size: 1.2rem;">Your Support Tickets</h4>
    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Domain</th>
                    <th>Status</th>
                    <th>Assigned Agent</th>
                    <th>Solution</th>
                    <th>Feedback Action</th>
                </tr>
            </thead>
            <tbody>
                <% if(tickets.length === 0) { %>
                    <tr><td colspan="7" class="text-center text-muted py-4">No support complaints raised yet.</td></tr>
                <% } %>
                <% tickets.forEach(t => { %>
                    <tr>
                        <td class="fw-semibold">#<%= t.id %></td>
                        <td><%= t.title %></td>
                        <td><span class="badge bg-light text-dark border"><%= t.domain %></span></td>
                        <td>
                            <span class="badge bg-<%= t.status === 'Resolved' ? 'success' : (t.status === 'In Progress' ? 'info text-dark' : 'warning text-dark') %>">
                                <%= t.status %>
                            </span>
                        </td>
                        <td><%= t.agent_name || 'Unassigned' %></td>
                        <td style="max-width: 200px;"><%= t.solution || 'Pending resolution...' %></td>
                        <td>
                            <% if(t.status === 'Resolved') { %>
                                <form action="/client/feedback/<%= t.id %>" method="POST" class="mt-1">
                                    <select name="rating" class="form-select form-select-sm mb-1" required>
                                        <option value="">Rate 1-5</option>
                                        <option value="5">5 - Excellent</option>
                                        <option value="4">4 - Good</option>
                                        <option value="3">3 - Average</option>
                                        <option value="2">2 - Poor</option>
                                        <option value="1">1 - Terrible</option>
                                    </select>
                                    <input type="text" name="comments" placeholder="Add comments" class="form-control form-control-sm mb-1">
                                    <button class="btn btn-sm btn-success w-100 py-1" style="font-size: 0.8rem;">Submit Feedback</button>
                                </form>
                            <% } else { %>
                                <span class="text-muted small">Available upon resolution</span>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    <title>Raise Issue</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="container py-5 d-flex justify-content-center align-items-center vh-100">
    <div class="card p-5 shadow-sm" style="width: 600px;">
        <h3 class="fw-bold mb-4 text-dark">Raise a New Complaint</h3>
        <form method="POST" action="/client/raise">
            <div class="mb-3">
                <label class="form-label text-muted small fw-semibold">Issue Title</label>
                <input type="text" name="title" class="form-control" required>
            </div>
            <div class="mb-3">
                <label class="form-label text-muted small fw-semibold">Support Domain</label>
                <select name="domain" class="form-select" required>
                    <option value="Technical">Technical</option>
                    <option value="Billing">Billing</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="form-label text-muted small fw-semibold">Detailed Description</label>
                <textarea name="description" class="form-control" rows="4" required></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Submit Complaint</button>
                <a href="/client/dashboard" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</body>
</html>
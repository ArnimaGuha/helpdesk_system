<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="container py-5" style="max-width: 1100px;">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bold text-dark">Admin Analytics Dashboard</h2>
            <p class="text-muted mb-0">System performance overview and metrics</p>
        </div>
        <a href="/logout" class="btn btn-outline-danger">Logout</a>
    </div>

    <div class="row text-center g-4 mb-4">
        <div class="col-md-3">
            <div class="card p-4">
                <span class="text-muted small fw-semibold">Total Complaints</span>
                <h3 class="fw-bold text-dark mt-2 mb-0"><%= stats.total_tickets %></h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-4">
                <span class="text-muted small fw-semibold">Open / Reported</span>
                <h3 class="fw-bold text-warning mt-2 mb-0"><%= stats.open_tickets %></h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-4">
                <span class="text-muted small fw-semibold">Solved Tickets</span>
                <h3 class="fw-bold text-success mt-2 mb-0"><%= stats.solved_tickets %></h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-4">
                <span class="text-muted small fw-semibold">Average Rating</span>
                <h3 class="fw-bold text-primary mt-2 mb-0"><%= stats.avg_feedback ? stats.avg_feedback.toFixed(1) : 'N/A' %>/5</h3>
            </div>
        </div>
    </div>

    <div class="row text-center g-4 mb-5">
        <div class="col-md-6">
            <div class="card p-4 border-0 bg-white">
                <span class="text-muted small fw-semibold">Total Customers</span>
                <h3 class="fw-bold text-dark mt-2 mb-0"><%= stats.total_customers %></h3>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card p-4 border-0 bg-white">
                <span class="text-muted small fw-semibold">Total Support Agents</span>
                <h3 class="fw-bold text-dark mt-2 mb-0"><%= stats.total_agents %></h3>
            </div>
        </div>
    </div>

    <h4 class="mb-3 fw-semibold text-dark" style="font-size: 1.2rem;">Overall Client Feedback Log</h4>
    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>Client Name</th>
                    <th>Rating</th>
                    <th>Comments</th>
                </tr>
            </thead>
            <tbody>
                <% if(feedbacks.length === 0) { %>
                    <tr><td colspan="3" class="text-center text-muted py-4">No feedback logs registered yet.</td></tr>
                <% } %>
                <% feedbacks.forEach(f => { %>
                    <tr>
                        <td class="fw-semibold"><%= f.client_name %></td>
                        <td><span class="badge bg-light text-dark border"><%= f.rating %> / 5</span></td>
                        <td><%= f.comments || 'No comments left.' %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
</html>
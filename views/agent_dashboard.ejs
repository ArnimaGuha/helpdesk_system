<!DOCTYPE html>
<html>
<head>
    <title>Agent Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="container py-5" style="max-width: 1100px;">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bold text-dark">Agent Support Portal</h2>
            <p class="text-muted mb-0">Active Domain: <span class="fw-semibold text-primary"><%= user.domain %></span></p>
        </div>
        <a href="/logout" class="btn btn-outline-danger">Logout</a>
    </div>

    <h4 class="mb-3 fw-semibold text-dark" style="font-size: 1.2rem;">Complaints in Your Domain</h4>
    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Client Name</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% if(tickets.length === 0) { %>
                    <tr><td colspan="5" class="text-center text-muted py-4">No active complaints found in this domain.</td></tr>
                <% } %>
                <% tickets.forEach(t => { %>
                    <tr>
                        <td class="fw-semibold">#<%= t.id %></td>
                        <td><%= t.client_name %></td>
                        <td><%= t.title %></td>
                        <td>
                            <span class="badge bg-<%= t.status === 'Resolved' ? 'success' : (t.status === 'In Progress' ? 'info text-dark' : 'warning text-dark') %>">
                                <%= t.status %>
                            </span>
                        </td>
                        <td><a href="/agent/ticket/<%= t.id %>" class="btn btn-sm btn-primary">Resolve or Update</a></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    <title>Resolve Ticket</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="container py-5 d-flex justify-content-center align-items-center vh-100">
    <div class="card p-5 shadow-sm" style="width: 650px;">
        <h3 class="fw-bold mb-3 text-dark">Ticket Review #<%= ticket.id %></h3>
        <div class="mb-3 p-3 bg-light rounded-3 border-0">
            <p class="mb-1"><strong>Client:</strong> <%= ticket.client_name %></p>
            <p class="mb-1"><strong>Title:</strong> <%= ticket.title %></p>
            <p class="mb-0"><strong>Description:</strong> <%= ticket.description %></p>
        </div>
        
        <form method="POST" action="/agent/ticket/<%= ticket.id %>">
            <div class="mb-3">
                <label class="form-label text-muted small fw-semibold">Provide Solution</label>
                <textarea name="solution" class="form-control" rows="3" required><%= ticket.solution %></textarea>
            </div>
            <div class="mb-4">
                <label class="form-label text-muted small fw-semibold">Ticket Status</label>
                <select name="status" class="form-select">
                    <option value="Open" <%= ticket.status=='Open'?'selected':'' %>>Open</option>
                    <option value="In Progress" <%= ticket.status=='In Progress'?'selected':'' %>>In Progress</option>
                    <option value="Resolved" <%= ticket.status=='Resolved'?'selected':'' %>>Resolved</option>
                </select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success flex-grow-1">Update Ticket</button>
                <a href="/agent/dashboard" class="btn btn-outline-secondary">Back</a>
            </div>
        </form>

        <% if(feedback) { %>
            <div class="card mt-4 p-3 border border-success bg-white shadow-none">
                <h6 class="fw-semibold text-success mb-2">Client Feedback Received</h6>
                <p class="mb-1 text-muted small"><strong>Rating:</strong> <%= feedback.rating %> / 5</p>
                <p class="mb-0 text-muted small"><strong>Comments:</strong> <%= feedback.comments || 'No comments provided.' %></p>
            </div>
        <% } %>
    </div>
</body>
</html>